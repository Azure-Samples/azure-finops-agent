<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AzureFinOps.Dashboard</RootNamespace>
    <UserSecretsId>1190b8a4-6595-436b-9479-b9951bd00f16</UserSecretsId>
    <!--
      Let GitHub.Copilot.SDK select its matching CLI runtime. A stale
      CopilotCliVersion override left SDK 1.0.11 running CLI 1.0.70 instead
      of 1.0.79; ordinary chat still worked, but native image attachments
      reached the provider as invalid image data. If an SDK release ever
      references an unpublished CLI package, use only a temporary override
      and remove it as soon as the matching final is available.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="GitHub.Copilot.SDK" Version="1.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />
  </ItemGroup>

  <!-- Embed Python script templates as resources (loaded at runtime by tools) -->
  <ItemGroup>
    <EmbeddedResource Include="AI\Tools\Resources\*.py" />
  </ItemGroup>

</Project>
