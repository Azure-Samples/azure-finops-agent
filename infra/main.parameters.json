{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "aoaiLocation": {
      "value": "${AZURE_OPENAI_LOCATION=swedencentral}"
    },
    "appServicePlanSku": {
      "value": "${APP_SERVICE_PLAN_SKU=B1}"
    },
    "aoaiModelName": {
      "value": "${AZURE_OPENAI_MODEL_NAME=gpt-6.1-sol}"
    },
    "aoaiModelVersion": {
      "value": "${AZURE_OPENAI_MODEL_VERSION=2026-09-29}"
    },
    "aoaiDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_NAME=gpt-6.1-sol}"
    },
    "aoaiModelCapacity": {
      "value": "${AZURE_OPENAI_MODEL_CAPACITY=1000}"
    },
    "aoaiServiceTier": {
      "value": "${AZURE_OPENAI_SERVICE_TIER=Default}"
    },
    "aoaiReasoningEffort": {
      "value": "${AZURE_OPENAI_REASONING_EFFORT=medium}"
    },
    "aoaiWebSearch": {
      "value": "${AZURE_OPENAI_WEB_SEARCH=true}"
    },
    "existingAoaiResourceId": {
      "value": "${EXISTING_AOAI_RESOURCE_ID=}"
    },
    "deployModelOnExistingAccount": {
      "value": "${AZURE_OPENAI_DEPLOY_ON_EXISTING=false}"
    },
    "existingAoaiProjectName": {
      "value": "${EXISTING_AI_PROJECT_NAME=}"
    },
    "entraAppId": {
      "value": "${AZURE_ENTRA_APP_ID=}"
    },
    "entraClientSecret": {
      "value": "${AZURE_ENTRA_CLIENT_SECRET=}"
    },
    "entraTenantId": {
      "value": "${AZURE_ENTRA_TENANT_ID=common}"
    },
    "customDomainName": {
      "value": "${AZURE_CUSTOM_DOMAIN=}"
    },
    "dmarcReportEmail": {
      "value": "${DMARC_REPORT_EMAIL=}"
    },
    "enableDeleteLocks": {
      "value": "${ENABLE_DELETE_LOCKS=false}"
    },
    "appServiceInboundIp": {
      "value": "${APP_SERVICE_INBOUND_IP=}"
    },
    "previewSlotName": {
      "value": "${AZURE_PREVIEW_SLOT_NAME=}"
    },
    "previewDeploySubjects": {
      "value": "${AZURE_PREVIEW_DEPLOY_SUBJECTS=}"
    }
  }
}
