{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "aoaiLocation": {
      "value": "${AZURE_OPENAI_LOCATION=swedencentral}"
    },
    "appServicePlanSku": {
      "value": "${APP_SERVICE_PLAN_SKU=B1}"
    },
    "aoaiModelName": {
      "value": "${AZURE_OPENAI_MODEL_NAME=gpt-5.6-sol}"
    },
    "aoaiModelVersion": {
      "value": "${AZURE_OPENAI_MODEL_VERSION=2026-07-09}"
    },
    "aoaiDeploymentName": {
      "value": "${AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5.6-sol}"
    },
    "aoaiModelCapacity": {
      "value": "${AZURE_OPENAI_MODEL_CAPACITY=1000}"
    },
    "existingAoaiResourceId": {
      "value": "${EXISTING_AOAI_RESOURCE_ID=}"
    },
    "entraAppId": {
      "value": "${AZURE_ENTRA_APP_ID=}"
    },
    "entraClientSecret": {
      "value": "${AZURE_ENTRA_CLIENT_SECRET=}"
    },
    "entraTenantId": {
      "value": "${AZURE_ENTRA_TENANT_ID=common}"
    },
    "customDomainName": {
      "value": "${AZURE_CUSTOM_DOMAIN=}"
    },
    "dmarcReportEmail": {
      "value": "${DMARC_REPORT_EMAIL=}"
    },
    "enableDeleteLocks": {
      "value": "${ENABLE_DELETE_LOCKS=false}"
    },
    "appServiceInboundIp": {
      "value": "${APP_SERVICE_INBOUND_IP=}"
    }
  }
}
